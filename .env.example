# OmniPull Environment Variables
# Copy this file to .env and fill in your values

# Redis connection URL
# Local development: redis://localhost:6379/0
# Docker Compose: redis://redis:6379/0  (set automatically)
REDIS_URL=redis://localhost:6379/0

# Temporary download directory
TMP_DIR=/tmp/omnipull

# Server port
PORT=8000

# Temporary-file retention period in seconds
TMP_RETENTION_SECONDS=1800

# Comma-separated origins for a separately hosted development frontend.
# Leave empty when using OmniPull's bundled frontend (the default).
CORS_ORIGINS=

