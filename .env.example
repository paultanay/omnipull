# OmniPull Environment Variables
# Copy this file to .env and fill in your values

# Redis connection URL
# Local development: redis://localhost:6379/0
# Docker Compose: redis://redis:6379/0  (set automatically)
REDIS_URL=redis://localhost:6379/0

# Temporary download directory
TMP_DIR=/tmp/omnipull

# Server port
PORT=8000

# Path to Netscape-format cookies file (for YouTube bot detection bypass)
# Export from your browser using "Get cookies.txt LOCALLY" extension while on youtube.com
# Place the file at the project root as cookies.txt
# It is gitignored - never commit your cookies
COOKIES_FILE=/app/cookies.txt
